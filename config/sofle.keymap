//  │       │     │     │     │     │     │                            │     │     │     │     │     │       │
//  ├───────┼─────┼─────┼─────┼─────┼─────┤                            ├─────┼─────┼─────┼─────┼─────┼───────┤
//  │       │     │     │     │     │     │                            │     │     │     │     │     │       │
//  ├───────┼─────┼─────┼─────╆━━━━━╅─────┤   ╭───────╮    ╭───────╮   ├─────╆━━━━━╅─────┼─────┼─────┼───────┤
//  │       │     │     │     ┃     ┃     │   │       │    │       │   │     ┃     ┃     │     │     │       │
//  ├───────┼─────┼─────┼─────╄━━━━━╃─────┤   │       │    │       │   ├─────╄━━━━━╃─────┼─────┼─────┼───────┤
//  │       │     │     │     │     │     │   ╰───────╯    ╰───────╯   │     │     │     │     │     │       │
//  └───────┴┬────┴┬────┴┬────┴┬────┴┬────┴┐                      ┌────┴┬────┴┬────┴┬────┴┬────┴┬────┴───────┘
