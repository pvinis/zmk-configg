#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/ext_power.h>

#include "pvinis_shared.dtsi"

/ {
	// activate KBCTL layer by pressing SYSCTL and SYMBOL
	conditional_layers {
		compatible = "zmk,conditional-layers";
		adjust_layer {
			if-layers = <SYSCTL SYMBOL>;
			then-layer = <KBCTL>;
		};
	};
	
	keymap {
		compatible = "zmk,keymap";
		
		qwerty_layer {
			display-name = "qwerty";
			//  ┌─────────┬─────┬─────┬─────┬─────┬─────┐                            ┌─────┬─────┬─────┬─────┬─────┬───────┐
			//  │   NUM   │  1  │  2  │  3  │  4  │  5  │                            │  6  │  7  │  8  │  9  │  0  │  F12  │
			//  ├─────────┼─────┼─────┼─────┼─────┼─────┤                            ├─────┼─────┼─────┼─────┼─────┼───────┤
			//  │   TAB   │  Q  │  W  │  E  │  R  │  T  │                            │  Y  │  U  │  I  │  O  │  P  │       │
			//  ├─────────┼─────┼─────┼─────╆━━━━━╅─────┤   ╭───────╮    ╭───────╮   ├─────╆━━━━━╅─────┼─────┼─────┼───────┤
			//  │ ESC/CTL │  A  │  S  │  D  ┃  F  ┃  G  │   │ VOL↻ │    │ SPOT  │   │  H  ┃  J  ┃  K  │  L  │  ;  │ ENTER │
			//  ├─────────┼─────┼─────┼─────╄━━━━━╃─────┤   │ MUTE  │    │ VOL↻ │   ├─────╄━━━━━╃─────┼─────┼─────┼───────┤
			//  │  SHIFT  │  Z  │  X  │  C  │  V  │  B  │   ╰───────╯    ╰───────╯   │  N  │  M  │  ,  │  .  │  /  │ SHIFT │
			//  └─────────┴┬────┴┬────┴┬────┴┬────┴┬────┴┐                      ┌────┴┬────┴┬────┴┬────┴┬────┴┬────┴───────┘
			//             │     │ ALT │ GUI │SMBL │BSPC │                      │SPACE│SYSCT│HYPER│     │     │
			//             └─────┴─────┴─────┴─────┴─────┘                      └─────┴─────┴─────┴─────┴─────┘
			//
			bindings = <
			&mo NUMBER     &kp N1    &kp N2    &kp N3    &kp N4    &kp N5                                     &kp N6      &kp N7     &kp N8     &kp N9   &kp N0    &kp F12
			&kp TAB        &kp Q     &kp W     &kp E     &kp R     &kp T                                      &kp Y       &kp U      &kp I      &kp O    &kp P     ______
			&mt LCTRL ESC  &kp A     &kp S     &kp D     &kp F     &kp G                                      &kp H       &kp J      &kp K      &kp L    &kp SEMI  &kp ENTER
			&kp LSHFT      &kp Z     &kp X     &kp C     &kp V     &kp B       &kp C_MUTE    &kp PV_SP_MUTE   &kp N       &kp M      &kp COMMA  &kp DOT  &kp FSLH  &kp RSHFT
			/**/                     ______    &kp LALT  &kp LGUI  &mo SYMBOL  &kp BSPC      &kp SPACE        &mo SYSCTL  &kp HYPER  ______     ______                  /**/
			>;
			
			sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PV_SP_VOLU PV_SP_VOLD>;
		};
		
		
		
		sysctl_layer {
			display-name = "sysctl";
			//  ┌─────────┬─────┬─────┬─────┬─────┬─────┐                            ┌─────┬─────┬─────┬─────┬─────┬───────┐
			//  │         │ F1  │ F2  │ F3  │ F4  │ F5  │                            │MUTE │HOME │ UP  │ END │SLP  │       │
			//  ├─────────┼─────┼─────┼─────┼─────┼─────┤                            ├─────┼─────┼─────┼─────┼─────┼───────┤
			//  │         │ F6  │ F7  │ F8  │ F9  │ F10 │                            │VOL+ │LEFT │DOWN │RGHT │SSVR │       │
			//  ├─────────┼─────┼─────┼─────╆━━━━━╅─────┤   ╭───────╮    ╭───────╮   ├─────╆━━━━━╅─────┼─────┼─────┼───────┤
			//  │         │ F11 │ F12 │     ┃     ┃     │   │ VOL↻ │    │ PG ↕  │   │PREV ┃ PLAY┃NEXT │LOCK │     │       │
			//  ├─────────┼─────┼─────┼─────╄━━━━━╃─────┤   │       │    │       │   ├─────╄━━━━━╃─────┼─────┼─────┼───────┤
			//  │         │     │     │     │     │     │   ╰───────╯    ╰───────╯   │     │     │     │     │     │       │
			//  └─────────┴┬────┴┬────┴┬────┴┬────┴┬────┴┐                      ┌────┴┬────┴┬────┴┬────┴┬────┴┬────┴───────┘
			//             │ GUI │     │SPACE│     │     │                      │     │     │ ALT │     │     │
			//             └─────┴─────┴─────┴─────┴─────┘                      └─────┴─────┴─────┴─────┴─────┘
			//
			bindings = <
			&none      &none    &none    &none    &none   &none                                  &kp C_MUTE    &kp HOME    &kp UP            &kp END     &kp C_SLEEP           &none
			&none      &kp F1   &kp F2   &kp F3   &kp F4  &kp F5                                 &kp C_VOL_UP  &kp LEFT    &kp DOWN          &kp RIGHT   &kp C_AL_SCREENSAVER  &none
			&none      &kp F6   &kp F7   &kp F8   &kp F9  &kp F10                                &kp C_VOL_DN  &kp C_PREV  &kp C_PLAY_PAUSE  &kp C_NEXT  &kp C_AL_LOCK         &none
			&none      &kp F11  &kp F12  &none    &none   &none     &none         &none          &none         &none       &none             &none       &none                 &none
			/**/                &none    &none    &none   &none     &none         &none          &none         &none       &none             &none                                   /**/
			>;

			sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
		};
		
		
		
	};
};
// &bt BT_CLR        &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3    &bt BT_SEL 4                            &none &none &none &none &none &none

